# Benchmark data and reports. Not committed: FinDVer/ is a clone of
# https://github.com/yilunzhao/FinDVer.git (pinned at commit e8bb237).
# 1.3 GB of upstream data and outputs. See README.md for setup.
FinDVer/

.env
.env.*

# Per-example run output. Regenerated by the pipeline, grows fast.
results/

# Console output from runs, captured with tee. The per-example JSON in
# results/ is the real record; these are for reading progress and tracebacks.
logs/

# Cached nomic-embed-text vectors, raw float32, one file per report. Derived
# data: delete it and test_scripts/build_embedding_index.py rebuilds it.
# ~178 MB for the full 60,871-element index. See section 11 item 11 of the plan.
embeddings/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# macOS
.DS_Store


CLAUDE.md
